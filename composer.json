{
  "name": "techghor/laravel-license-manager",
  "description": "A Laravel package for managing software licenses",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "TechGhor",
      "email": "mohd.yasin2012@gmail.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/support": "^10.0 || ^11.0 || ^12.0",
    "illuminate/http": "^10.0 || ^11.0 || ^12.0"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
    "phpunit/phpunit": "^10.0 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "TechGhor\\LaravelLicenseManager\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "TechGhor\\LaravelLicenseManager\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "TechGhor\\LaravelLicenseManager\\LicenseManagerServiceProvider"
      ],
      "aliases": {
        "LicenseManager": "TechGhor\\LaravelLicenseManager\\Facades\\LicenseManager"
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}